---
import Layout from '~/layouts/PageLayout.astro';

import Hero from '~/components/widgets/Hero.astro';
import Content from '~/components/widgets/Content.astro';
import Features from '~/components/widgets/Features.astro';
import Stats from '~/components/widgets/Stats.astro';
import Testimonials from '~/components/widgets/Testimonials.astro';
import FAQs from '~/components/widgets/FAQs.astro';
import CallToAction from '~/components/widgets/CallToAction.astro';

const contactHref = 'https://ecosoft.frappe.cloud/contact-us/new';

const metadata = {
  title: 'Floworks AI ERP — open source ERP, company memory, AI agents',
};
---

<Layout metadata={metadata}>
  <!-- Hero *************************** -->
  <Hero
    callToAction={{
      targetBlank: true,
      text: 'Talk to us',
      href: contactHref,
      icon: 'tabler:mail',
    }}
  >
    <Fragment slot="title">
      Floworks <span class="text-accent dark:text-white highlight text-5xl font-normal tracking-normal">AI ERP</span>
    </Fragment>

    <Fragment slot="subtitle">
      <span class="hidden sm:inline">Run your company. Not your software.</span>
    </Fragment>

    <Fragment slot="content">
      ERPNext as the system of record, a second brain for what your company knows, and agents that do the work.
    </Fragment>
  </Hero>

  <!-- Problem *********************** -->
  <Content
    id="problem"
    isReversed
    items={[
      { title: 'Data entered by hand.' },
      { title: "Answers stuck in one person's head." },
      { title: 'Work nobody has time to chase.' },
    ]}
    image={{
      src: '~/assets/images/erp.png',
      alt: 'ERP',
    }}
  >
    <Fragment slot="content">
      <h3 class="text-2xl font-bold tracking-tight dark:text-white sm:text-3xl mb-2">
        The ERP was a breakthrough. Then it became a job.
      </h3>
      Every trading and manufacturing company hits this wall at some point: the system that was meant to run the
      business ends up needing someone to run it.
    </Fragment>

    <Fragment slot="bg">
      <div class="absolute inset-0 bg-slate-50 dark:bg-transparent"></div>
    </Fragment>
  </Content>

  <!-- Three parts ******************* -->
  <Features
    id="three-parts"
    title="Three parts, working as one"
    columns={3}
    items={[
      {
        title: 'ERPNext — the system of record',
        description:
          'Orders, invoices, inventory, purchasing, projects and HR in one shared data model.',
        icon: 'tabler:database',
      },
      {
        title: "The Brain — your company's memory",
        description:
          'How you quote, how you price, how you handle the exception — kept where it belongs, not in someone’s inbox.',
        icon: 'tabler:brain',
      },
      {
        title: 'Hermes — the agents',
        description:
          'Agents that read the records, follow your rules and take the action — under the same permissions and audit trail as your staff.',
        icon: 'tabler:robot',
      },
    ]}
  />

  <!-- Ownership ********************* -->
  <Content
    id="ownership"
    isAfterContent
    items={[
      { title: 'Your data, in your database, on infrastructure you choose.' },
      { title: 'No per-seat licence.' },
      { title: 'The source code is yours when the project ends.' },
      { title: 'Extend it yourself, or with us.' },
    ]}
    image={{
      src: '~/assets/images/oxp_logo_glow.svg',
      alt: 'Open source',
    }}
  >
    <Fragment slot="content">
      <h3 class="text-2xl font-bold tracking-tight dark:text-white sm:text-3xl mb-2">You own it.</h3>
      Floworks AI ERP is built on open-source software — ERPNext (GPLv3) and Hermes (MIT). The stack may evolve; the
      principle will not.
    </Fragment>

    <Fragment slot="bg">
      <div class="absolute inset-0 bg-slate-50 dark:bg-transparent"></div>
    </Fragment>
  </Content>

  <!-- A normal Tuesday ************** -->
  <Content
    id="a-tuesday"
    isReversed
    isAfterContent
    items={[
      { title: 'A shipment slips — the agent finds the affected orders and drafts the supplier email.' },
      { title: 'Stock runs low — it prepares the purchase order before the line stops.' },
      { title: 'A customer asks for a quote like one from two years ago — the memory finds the original terms.' },
      { title: 'Month-end — the cash-flow forecast is built from real commitments, not a spreadsheet.' },
    ]}
    image={{
      src: '~/assets/images/workflow2.png',
      alt: 'Automation',
    }}
  >
    <Fragment slot="content">
      <h3 class="text-2xl font-bold tracking-tight dark:text-white sm:text-3xl mb-2">
        What it does on an ordinary Tuesday
      </h3>
      Anything irreversible — paying, posting, emailing a customer — waits for a human approval.
    </Fragment>

    <Fragment slot="bg">
      <div class="absolute inset-0 bg-slate-50 dark:bg-transparent"></div>
    </Fragment>
  </Content>

  <!-- Who it is for ***************** -->
  <Content
    id="who-its-for"
    isAfterContent
    items={[
      { title: 'You already run ERPNext — we add the memory and the agents.' },
      { title: "You're starting from spreadsheets — you get all three at once." },
    ]}
    image={{
      src: '~/assets/images/industries.jpg',
      alt: 'Industries',
    }}
  >
    <Fragment slot="content">
      <h3 class="text-2xl font-bold tracking-tight dark:text-white sm:text-3xl mb-2">Who it is for</h3>
      Trading and manufacturing companies that have outgrown spreadsheets. Two starting points, one offer.
    </Fragment>

    <Fragment slot="bg">
      <div class="absolute inset-0 bg-slate-50 dark:bg-transparent"></div>
    </Fragment>
  </Content>

  <!-- Why Ecosoft ******************* -->
  <Features
    id="why-ecosoft"
    title="Why Ecosoft"
    subtitle="Open-source software and AI, across consulting, implementation, migration, training and support."
    columns={2}
    items={[
      {
        title: '10+ years, 40+ ERP projects',
        description:
          'We start from how your business actually runs — because an ERP has to be right for your accounting and tax.',
        icon: 'tabler:bulb',
      },
      {
        title: 'You own the system',
        description:
          'When a project ends, we hand over the source code. No strings attached.',
        icon: 'tabler:lock-off',
      },
      {
        title: 'Built to last',
        description:
          'We care how software is built, because it has to be maintainable by whoever comes after us.',
        icon: 'tabler:award',
      },
      {
        title: 'A long-term partner',
        description: 'An ERP is load-bearing. We stay with you after go-live.',
        icon: 'tabler:heart',
      },
    ]}
  />

  <Stats
    id="ecosoft-figures"
    title=""
    stats={[
      { title: 'Years in business', amount: '10+' },
      { title: 'Deployed Users', amount: '4K' },
      { title: 'Customers', amount: '40+' },
      { title: 'Modules Contributed', amount: '120+' },
    ]}
  />

  <!-- Case: EOS Orbit *************** -->
  <Content
    id="eos-orbit"
    items={[
      { title: 'Component procurement and assembly logs' },
      { title: 'Thai payroll, project costing and quality assurance' },
      { title: 'One system instead of spreadsheets' },
    ]}
    image={{
      src: '~/assets/images/modules.png',
      alt: 'ERPNext modules',
    }}
  >
    <Fragment slot="content">
      <h3 class="text-2xl font-bold tracking-tight dark:text-white sm:text-3xl mb-2">
        They build satellites with it
      </h3>
      <b>EOS Orbit</b> — Thailand’s first satellite manufacturer — needed an ERP that could follow how they actually
      engineer. Traditional systems were too rigid. With Ecosoft they built the workflows around their real process,
      and went live on time.
    </Fragment>

    <Fragment slot="bg">
      <div class="absolute inset-0 bg-slate-50 dark:bg-transparent"></div>
    </Fragment>
  </Content>

  <Testimonials
    id="eos-orbit-quote"
    title=""
    testimonials={[
      {
        title: 'EOS Orbit Co Ltd',
        testimonial:
          'Ecosoft helped transform our operations with ERPNext. Their expertise gave EOS Orbit the system we needed to build Thailand’s first operational satellite, and to scale our mission beyond Earth.',
        name: 'Supiti Buranawatanachoke',
        job: 'Chairman, EOS Orbit',
      },
    ]}
  />

  <!-- FAQ *************************** -->
  <FAQs
    id="faq"
    title="Questions we get asked"
    columns={1}
    items={[
      {
        title: 'Is it open source?',
        description: 'Yes — ERPNext (GPLv3) and Hermes (MIT). Your data sits in a database you control.',
      },
      {
        title: 'Where does our data live?',
        description: 'Wherever you choose — your server, a cloud region, or infrastructure we manage.',
      },
      {
        title: 'Will an AI touch my ledger without asking?',
        description:
          'No. Agents act as users with assigned roles, everything is logged, and anything irreversible waits for approval.',
      },
      {
        title: 'We already have an ERP. Do we have to throw it away?',
        description:
          'Not necessarily. We can migrate, run alongside it, or start with the memory and the agents while your current system stays.',
      },
    ]}
  />

  <!-- Call to action **************** -->
  <CallToAction
    id="talk-to-us"
    title="Talk to us"
    subtitle="Tell us how your company runs today, and we'll show you where the memory and the agents earn their keep first."
    callToAction={{
      targetBlank: true,
      text: 'Get in touch',
      href: contactHref,
      icon: 'tabler:mail',
    }}
  />
</Layout>
