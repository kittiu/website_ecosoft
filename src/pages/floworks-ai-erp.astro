---
import Layout from '~/layouts/PageLayout.astro';

import Hero from '~/components/widgets/Hero.astro';
import Content from '~/components/widgets/Content.astro';
import Features from '~/components/widgets/Features.astro';
import FAQs from '~/components/widgets/FAQs.astro';
import CallToAction from '~/components/widgets/CallToAction.astro';

const contactHref = 'https://ecosoft.frappe.cloud/contact-us/new';

const metadata = {
  title: 'Floworks AI ERP — 100% open source ERP, company memory and AI agents',
};
---

<Layout metadata={metadata}>
  <!-- Floworks brand theme: navy #0B2A4A / #123A63, orange #FF7A29 / #F0580B -->
  <div class="floworks-page">
    <!-- Hero Widget ******************* -->
    <Hero
      callToAction={{
        targetBlank: true,
        text: 'Contact Us',
        href: contactHref,
        icon: 'tabler:mail',
      }}
    >
      <Fragment slot="title">
        FLOWORKS <span class="text-accent dark:text-white highlight text-5xl font-normal tracking-normal">AI ERP</span>
      </Fragment>

      <Fragment slot="subtitle">
        <span class="hidden sm:inline">
          <span class="font-semibold">100% Open Source</span><br />Run your company. Not your software.</span
        >
      </Fragment>

      <Fragment slot="content">
        <div class="mt-12 md:mt-16 grid grid-cols-1 sm:grid-cols-3 gap-8 sm:gap-6 max-w-3xl mx-auto text-slate-300">
          <div>
            <p class="text-lg mb-1"><b>ERPNext</b></p>
            <p class="text-base">your reliable system of record</p>
          </div>
          <div>
            <p class="text-lg mb-1"><b>Company Brain</b></p>
            <p class="text-base">holds what your company knows</p>
          </div>
          <div>
            <p class="text-lg mb-1"><b>Hermes AI Agent</b></p>
            <p class="text-base">connects everything and gives you insights</p>
          </div>
        </div>
      </Fragment>
    </Hero>

    <!-- Three parts, working as one **** -->
    <Content
      id="three-parts"
      isReversed
      items={[
        {
          title: 'ERPNext — the system of record',
          description:
            'Orders, invoices, inventory, purchasing, projects and HR in one shared data model. Open source, mature, and already running the operations of companies like yours.',
          icon: 'tabler:database',
        },
        {
          title: "The Brain — your company's memory",
          description:
            'Not a chat window over a search index: a knowledge base your agents curate and keep current, where answers compound instead of being rediscovered every time. How you quote, how you price, how you handle the exception, which supplier actually delivers.',
          icon: 'tabler:brain',
        },
        {
          title: 'Hermes — the agentic AI',
          description:
            'Agents that read the records, follow your rules and take the action — chasing the delayed shipment, drafting the supplier email, raising the reorder before you run out. Under the same permissions and the same audit trail as your staff.',
          icon: 'tabler:robot',
        },
      ]}
    >
      <Fragment slot="image">
        <img src="/images/floworks-logo.svg" alt="Floworks" class="mx-auto w-full max-w-sm" />
        <img
          src="/images/floworks-ai-erp-architecture.svg"
          alt="Floworks AI ERP architecture"
          class="mx-auto mt-8 w-full"
        />
      </Fragment>

      <Fragment slot="content">
        <h3 class="text-2xl font-bold tracking-tight dark:text-white sm:text-3xl mb-2">
          Three parts, working as one
        </h3>
      </Fragment>

      <Fragment slot="bg">
        <div class="absolute inset-0 bg-slate-50 dark:bg-transparent"></div>
      </Fragment>
    </Content>

    <!-- Problem *********************** -->
    <Features
      id="problem"
      title="The ERP was a breakthrough. Then it became a job."
      subtitle="Every trading and manufacturing company that grows past a certain size hits the same wall. The system that was supposed to run the business needs someone to run it. That is the tax traditional ERP charges — and <b>Floworks AI ERP is our answer to it.</b>"
      columns={2}
      items={[
        { title: 'The data is in there — but someone has to type it in.' },
        { title: "The answer exists — but it lives in one senior person's head." },
        { title: 'The problem is visible — but nobody has the hours to chase it.' },
        { title: 'The licence, the consultants and the lock-in only ever go up.' },
      ]}
    />

    <!-- A normal Tuesday ************** -->
    <Content
      id="a-tuesday"
      isReversed
      isAfterContent
      items={[
        { title: 'A shipment slips. The agent spots it, finds the orders it touches, and drafts the supplier email for a human to approve.' },
        { title: 'Raw material runs low. It prepares the purchase order at the reorder point, before the line stops.' },
        { title: 'A customer asks for a quote like the one from two years ago. The Brain finds the original terms, the margin, and what has changed since.' },
        { title: 'Month-end. The cash-flow picture is assembled from real commitments, not a spreadsheet someone maintains by hand.' },
        { title: 'A new colleague starts. They ask the system how the company does things — and get the company’s answer, not a guess.' },
      ]}
      image={{
        src: '~/assets/images/workflow2.png',
        alt: 'Process Automation',
      }}
    >
      <Fragment slot="content">
        <h3 class="text-2xl font-bold tracking-tight dark:text-white sm:text-3xl mb-2">
          What it does on an ordinary Tuesday
        </h3>
        <b>Every irreversible action — paying, posting to the ledger, emailing a customer — stops at a human approval
        gate.</b> The agents are staff, not a blank cheque.
      </Fragment>

      <Fragment slot="bg">
        <div class="absolute inset-0 bg-slate-50 dark:bg-transparent"></div>
      </Fragment>
    </Content>

    <!-- Who it is for ***************** -->
    <Content
      id="who-its-for"
      isAfterContent
      items={[
        { title: 'You already run ERPNext with us — the memory and the agents are added on top of what you have.' },
        { title: 'You are starting from spreadsheets or an ageing system — you get the system of record, the memory and the agents in one move.' },
      ]}
      image={{
        src: '~/assets/images/industries.jpg',
        alt: 'Industries',
      }}
    >
      <Fragment slot="content">
        <h3 class="text-2xl font-bold tracking-tight dark:text-white sm:text-3xl mb-2">Who it is for</h3>
        <b>Trading and manufacturing companies</b> that have outgrown spreadsheets but do not want to spend the next
        five years serving a rigid, expensive system. Two starting points, one offer — what changes between them is the
        size of the implementation, not the product.
      </Fragment>

      <Fragment slot="bg">
        <div class="absolute inset-0 bg-slate-50 dark:bg-transparent"></div>
      </Fragment>
    </Content>

    <!-- FAQ *************************** -->
    <FAQs
      id="faq"
      title="Questions we get asked"
      columns={1}
      items={[
        {
          title: 'Is it really open source?',
          description:
            'Yes. The core is an open-source stack — ERPNext (GPLv3) and Hermes (MIT) — and your data sits in a database you control.',
        },
        {
          title: 'Where does our data live?',
          description:
            'Wherever you decide. On your own server, on a cloud region you choose, or on infrastructure we manage for you. It is your database either way.',
        },
        {
          title: 'Will an AI touch my ledger without asking?',
          description:
            'No. Agents act as users, with roles you assign, and everything they do is logged. Anything irreversible waits for a human approval.',
        },
        {
          title: 'We already have an ERP. Do we have to throw it away?',
          description:
            'Talk to us before you assume that. Depending on the system, we can migrate, run alongside it, or start with the memory and the agents while your current records stay where they are.',
        },
      ]}
    />

    <!-- Call to action **************** -->
    <CallToAction
      id="talk-to-us"
      title="Contact Us"
      subtitle="Tell us how your company actually runs today, and we will map where the memory and the agents would earn their keep first."
      callToAction={{
        targetBlank: true,
        text: 'Get in touch',
        href: contactHref,
        icon: 'tabler:mail',
      }}
    />
  </div>
</Layout>

<style>
  /*
    Floworks AI ERP — brand theme, taken from the Floworks logo.
    Scoped to this page only: the site-wide blue/purple tokens are untouched.
      navy   #0B2A4A -> #123A63
      orange #FF7A29 -> #F0580B
      slate  #5A7189
  */
  .floworks-page {
    /* display:contents so the wrapper adds no box and cannot disturb the hero's -105px offset */
    display: contents;

    --aw-color-primary: rgb(255 122 41); /* #FF7A29 — buttons, icons */
    --aw-color-secondary: rgb(11 42 74); /* #0B2A4A — button hover, deep accents */
    --aw-color-accent: rgb(255 122 41); /* #FF7A29 — highlights */
    --aw-color-text-heading: rgb(11 42 74); /* navy headings in light mode */

    /* brand oranges: the deep one is used for text on white (readable), the bright one on navy */
    --fw-orange: rgb(255 122 41); /* #FF7A29 */
    --fw-orange-deep: rgb(240 88 11); /* #F0580B */
  }

  /* Bold text carries the brand orange, site-wide on this page only */
  .floworks-page :global(b),
  .floworks-page :global(strong) {
    color: var(--fw-orange-deep);
  }

  /* On the navy hero the brighter orange reads better */
  .floworks-page > :global(section:first-child) :global(b) {
    color: var(--fw-orange);
  }

  /* Hero: the logo's navy gradient instead of the site's default #0d1b35 */
  .floworks-page > :global(section:first-child) {
    background-color: #0b2a4a;
    background-image: linear-gradient(135deg, #0b2a4a 0%, #123a63 100%);
  }

  /* The hero's particle canvas is hard-coded to a blue palette, which fights the brand.
     Hidden here; the navy gradient carries the hero instead. */
  .floworks-page > :global(section:first-child) :global(#hero-canvas) {
    display: none;
  }

  /* Hero subtitle is text-blue-200 — warm it to match the palette */
  .floworks-page > :global(section:first-child) :global(.text-blue-200) {
    color: rgb(255 224 204);
  }

  /* Hero: ~90% of the default height (684px -> ~616px). The 76px header spacer is untouched. */
  .floworks-page > :global(section:first-child) > :global(div) > :global(div:nth-child(2)) {
    padding-top: 62px;
    padding-bottom: 62px;
  }

  /* The Content widget draws its bullets as hard-coded green check circles */
  .floworks-page :global(.bg-green-600) {
    background-color: rgb(255 122 41) !important;
  }
</style>
