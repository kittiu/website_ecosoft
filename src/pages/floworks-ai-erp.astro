---
import Layout from '~/layouts/PageLayout.astro';

import Hero from '~/components/widgets/Hero.astro';
import Content from '~/components/widgets/Content.astro';
import FAQs from '~/components/widgets/FAQs.astro';
import CallToAction from '~/components/widgets/CallToAction.astro';
import WidgetWrapper from '~/components/ui/WidgetWrapper.astro';
import Headline from '~/components/ui/Headline.astro';

const contactHref = 'https://ecosoft.frappe.cloud/contact-us/new';

const metadata = {
  title: 'Floworks AI ERP — ERP โอเพนซอร์ส 100% พร้อมความจำของบริษัทและ AI Agent',
};
---

<Layout metadata={metadata}>
  <!-- Floworks brand theme: navy #0B2A4A / #123A63, orange #FF7A29 / #F0580B -->
  <div class="floworks-page">
    <!-- Hero Widget ******************* -->
    <Hero
      callToAction={{
        targetBlank: true,
        text: 'ติดต่อเรา',
        href: contactHref,
        icon: 'tabler:mail',
      }}
    >
      <Fragment slot="title">
        FLOWORKS <span class="text-accent dark:text-white highlight text-5xl font-normal tracking-normal">AI ERP</span>
      </Fragment>

      <Fragment slot="subtitle">
        <span class="hidden sm:inline">
          <span class="font-semibold">100% Open Source</span><br />Run your company. Not your software.</span
        >
      </Fragment>
    </Hero>

    <!-- Promise strip ****************** -->
    <section class="not-prose bg-[#FFF3E9] dark:bg-slate-800">
      <div class="max-w-6xl mx-auto px-4 sm:px-6 py-4 text-md text-center font-medium text-[#0B2A4A] dark:text-white">
        <span class="font-bold">
          Floworks AI ERP ขับเคลื่อนบริษัทของคุณด้วยโอเพนซอร์ส 100% — ERPNext, Company Brain และ AI Agent จาก Hermes
          <br />
          ให้คำปรึกษา - ติดตั้งระบบ - ย้ายระบบ - อบรม - ดูแลหลังการขาย
        </span>
      </div>
    </section>

    <!-- Stack logos ******************* -->
    <section class="not-prose py-6">
      <div class="max-w-4xl mx-auto px-4 sm:px-6">
        <div class="flex flex-wrap items-center justify-center gap-8 md:gap-12">
          <div class="flex items-center justify-center">
            <img
              src="/images/erpnext-mark.svg"
              alt="ERPNext"
              class="h-10 md:h-12 w-auto object-contain saturate-50 hover:saturate-100 transition duration-300"
            />
          </div>
          <div class="flex items-center justify-center">
            <img
              src="/images/hermes-logo.png"
              alt="Hermes AI Agent"
              class="h-10 md:h-12 w-auto object-contain saturate-50 hover:saturate-100 transition duration-300"
            />
          </div>
          <div class="flex items-center justify-center">
            <img
              src="/images/obsidian-logo.svg"
              alt="Obsidian"
              class="h-10 md:h-12 w-auto object-contain saturate-50 hover:saturate-100 transition duration-300"
            />
          </div>
          <div class="flex items-center justify-center">
            <img
              src="/images/mcp-logo.svg"
              alt="Model Context Protocol"
              class="h-10 md:h-12 w-auto object-contain saturate-50 hover:saturate-100 transition duration-300"
            />
          </div>
        </div>
      </div>
    </section>

    <!-- Three parts, working as one **** -->
    <Content
      id="three-parts"
      isReversed
      items={[
        {
          title: 'ERPNext — ระบบบันทึกข้อมูลหลักของบริษัท',
          description:
            'คำสั่งซื้อ ใบแจ้งหนี้ สินค้าคงคลัง การจัดซื้อ โครงการ และงานบุคคล อยู่ในโมเดลข้อมูลเดียวกันทั้งหมด เป็นโอเพนซอร์สที่ผ่านการใช้งานมายาวนาน และกำลังขับเคลื่อนการดำเนินงานของบริษัทอย่างของคุณอยู่แล้ว',
          icon: 'tabler:database',
        },
        {
          title: 'The Brain — ความจำของบริษัท',
          description:
            'ไม่ใช่แค่หน้าต่างแชทที่ต่อกับดัชนีค้นหา แต่เป็นฐานความรู้ที่ AI Agent ช่วยดูแลและอัปเดตให้ทันสมัยอยู่เสมอ คำตอบจึงสะสมต่อยอดกันไป ไม่ต้องเริ่มค้นใหม่ทุกครั้ง — บริษัทเสนอราคาอย่างไร ตั้งราคาแบบไหน รับมือข้อยกเว้นอย่างไร ซัพพลายเออร์รายใดส่งของได้จริง',
          icon: 'tabler:brain',
        },
        {
          title: 'Hermes — AI Agent ที่ลงมือทำงานจริง',
          description:
            'AI Agent ที่อ่านข้อมูลในระบบ ทำตามกติกาของคุณ และลงมือทำงานให้ — ตามของที่ล่าช้า ร่างอีเมลถึงซัพพลายเออร์ ออกใบสั่งซื้อซ้ำก่อนของจะหมด โดยอยู่ภายใต้สิทธิ์การใช้งานและร่องรอยการตรวจสอบชุดเดียวกับพนักงานของคุณ',
          icon: 'tabler:robot',
        },
      ]}
    >
      <Fragment slot="image">
        <img src="/images/floworks-logo.svg" alt="Floworks" class="mx-auto w-full max-w-sm" />
        <img
          src="/images/floworks-ai-erp-architecture.svg"
          alt="โครงสร้างการทำงานของ Floworks AI ERP"
          class="mx-auto mt-8 w-full"
        />
      </Fragment>

      <Fragment slot="content">
        <h3 class="text-2xl font-bold tracking-tight dark:text-white sm:text-3xl mb-2">
          สามส่วนที่ทำงานเป็นหนึ่งเดียว
        </h3>
      </Fragment>

      <Fragment slot="bg">
        <div class="absolute inset-0 bg-slate-50 dark:bg-transparent"></div>
      </Fragment>
    </Content>

    <!-- Why ERP needs AI *************** -->
    <WidgetWrapper id="why-ai">
      <Headline title="ทำไม ERP ต้องมี AI?" />

      <div class="mx-auto max-w-3xl space-y-6 text-lg text-muted dark:text-slate-400">
        <p>
          สำหรับบริษัทการค้าและการผลิตขนาดกลางและเล็ก ERP แบบดั้งเดิมเป็นดาบสองคม จำเป็นอย่างยิ่งต่อการดำเนินธุรกิจ
          แต่ก็มาพร้อมการคีย์ข้อมูลด้วยมือไม่รู้จบ การอบรมพนักงานที่ซับซ้อน
          และการถูกล็อกไว้กับผู้ขายรายเดิมที่มีค่าใช้จ่ายสูงและปรับเปลี่ยนอะไรได้ยาก
        </p>
        <p>
          <b>Floworks กำลังเปลี่ยนเรื่องนี้ ด้วย ERP ที่ทำงานได้เองอย่างเต็มรูปแบบที่เป็นโอเพนซอร์ส 100%</b>
        </p>
        <p>
          Floworks ถูกออกแบบมาสำหรับธุรกิจการค้าและการผลิตโดยเฉพาะ ผสานการทำงานมาตรฐานของ ERP เข้ากับ
          <b>Company Brain</b> ที่รวมศูนย์ไว้ที่เดียว และ AI Agent ที่ลงมือทำเชิงรุก เพราะ Floworks เป็นโอเพนซอร์ส 100%
          ธุรกิจของคุณจึงได้อธิปไตยทางดิจิทัลอย่างเต็มรูปแบบ ไม่มีค่าลิขสิทธิ์ที่เอาเปรียบ ไม่มีไซโลข้อมูลที่ซ่อนอยู่
          และไม่ถูกผูกมัดกับผู้ขายรายใดรายหนึ่ง คุณมีอิสระเต็มที่ในการโฮสต์ แก้ไข
          และขยายโครงสร้างพื้นฐานหลักของธุรกิจในแบบที่คุณเห็นว่าเหมาะสม
        </p>
        <p>
          แทนที่ทีมงานของคุณต้องคอยรับใช้ซอฟต์แวร์ที่แข็งทื่อ สถาปัตยกรรมเปิดของ Floworks ทำงานให้คุณแทน
          ระบบจะนำบริบทการดำเนินงานทั้งหมดของคุณ — ตั้งแต่อีเมลห่วงโซ่อุปทานที่ซับซ้อน ไฟล์ PDF จากผู้ขาย
          ไปจนถึงตารางการผลิตในโรงงาน — เข้าสู่ Company Brain ส่วนตัวที่ปลอดภัยอย่างต่อเนื่อง
          เมื่อมีบริบทที่รวมเป็นหนึ่งนี้ AI Agent ของ Floworks ไม่ได้แค่ติดตามธุรกิจของคุณ แต่ช่วยบริหารมันไปด้วย
        </p>
        <p>
          Floworks แจ้งเตือนจุดติดขัดในห่วงโซ่อุปทานโดยอัตโนมัติ ร่างการเจรจากับซัพพลายเออร์โดยอ้างอิงข้อมูลย้อนหลัง
          สั่งวัตถุดิบเพิ่มเมื่อสต็อกใกล้หมด และช่วยพยากรณ์กระแสเงินสดได้แม่นขึ้น ด้วย Floworks
          ผู้ผลิตและผู้ค้ารายกลางและเล็กจึงได้ทั้งพลังของ ERP ระดับองค์กร ความฉลาดของ AI ขั้นสูง
          และอิสระในการดำเนินงานเต็มรูปแบบจากโอเพนซอร์ส
        </p>
      </div>
    </WidgetWrapper>

    <!-- A normal Tuesday ************** -->
    <Content
      id="a-tuesday"
      isReversed
      isAfterContent
      items={[
        { title: 'ของส่งล่าช้า AI Agent เห็นเข้าไป ค้นหาว่ามีคำสั่งซื้อใดได้รับผลกระทบ และร่างอีเมลถึงซัพพลายเออร์ให้คนอนุมัติ' },
        { title: 'วัตถุดิบใกล้หมด ระบบเตรียมใบสั่งซื้อไว้ที่จุดสั่งซื้อซ้ำ ก่อนที่สายการผลิตจะต้องหยุด' },
        { title: 'ลูกค้าขอใบเสนอราคาแบบเดียวกับเมื่อสองปีก่อน The Brain ค้นเงื่อนไขเดิม อัตรากำไร และสิ่งที่เปลี่ยนไปนับจากนั้นได้' },
        { title: 'ปิดงบสิ้นเดือน ภาพกระแสเงินสดประกอบขึ้นจากข้อมูลจริงที่มีอยู่ในระบบ ไม่ใช่สเปรดชีตที่ต้องมีคนคอยอัปเดตด้วยมือ' },
        { title: 'พนักงานใหม่เริ่มงาน เขาถามระบบว่าบริษัททำงานกันอย่างไร แล้วได้คำตอบของบริษัทจริง ๆ ไม่ใช่การเดา' },
      ]}
    >

      <Fragment slot="image">
        <img
          src="/images/floworks-ordinary-tuesday.svg"
          alt="วันอังคารธรรมดา ๆ: สินค้าเคลื่อนผ่านคลังสินค้า"
          class="mx-auto w-full"
        />
      </Fragment>

      <Fragment slot="content">
        <h3 class="text-2xl font-bold tracking-tight dark:text-white sm:text-3xl mb-2">
          สิ่งที่มันทำในวันอังคารธรรมดา ๆ
        </h3>
        <b>ทุกการกระทำที่ย้อนกลับไม่ได้ — การจ่ายเงิน การบันทึกบัญชี การส่งอีเมลถึงลูกค้า — จะหยุดรอการอนุมัติจากคนเสมอ</b>
        AI Agent คือพนักงาน ไม่ใช่เช็คเปล่าที่เซ็นไว้ล่วงหน้า
      </Fragment>

      <Fragment slot="bg">
        <div class="absolute inset-0 bg-slate-50 dark:bg-transparent"></div>
      </Fragment>
    </Content>

    <!-- Who it is for ***************** -->
    <Content
      id="who-its-for"
      isAfterContent
      items={[
        { title: 'คุณใช้ ERPNext กับเราอยู่แล้ว — เราเติมความจำและ AI Agent เข้าไปบนระบบที่คุณมีอยู่' },
        { title: 'คุณเริ่มจากสเปรดชีตหรือระบบเก่า — คุณจะได้ทั้งระบบบันทึกข้อมูลหลัก ความจำ และ AI Agent ในครั้งเดียว' },
      ]}
    >

      <Fragment slot="image">
        <img
          src="/images/floworks-who-its-for.svg"
          alt="บริษัทการค้าและการผลิต"
          class="mx-auto w-full"
        />
      </Fragment>

      <Fragment slot="content">
        <h3 class="text-2xl font-bold tracking-tight dark:text-white sm:text-3xl mb-2">เหมาะกับใคร</h3>
        <b>บริษัทการค้าและการผลิต</b> ที่โตเกินกว่าจะใช้สเปรดชีตได้อีกแล้ว แต่ก็ไม่อยากเสียเวลาห้าปีข้างหน้าไปกับการรับใช้ระบบที่แข็งทื่อและมีค่าใช้จ่ายสูง
        จุดเริ่มต้นมีสองแบบ แต่ข้อเสนอเดียวกัน — สิ่งที่ต่างกันคือขอบเขตของการติดตั้ง ไม่ใช่ตัวผลิตภัณฑ์
      </Fragment>

      <Fragment slot="bg">
        <div class="absolute inset-0 bg-slate-50 dark:bg-transparent"></div>
      </Fragment>
    </Content>

    <!-- FAQ *************************** -->
    <FAQs
      id="faq"
      title="คำถามที่เรามักถูกถาม"
      columns={1}
      items={[
        {
          title: 'เป็นโอเพนซอร์สจริงหรือ?',
          description:
            'จริง แกนหลักเป็นสแตกโอเพนซอร์ส — ERPNext (GPLv3) และ Hermes (MIT) — และข้อมูลของคุณอยู่ในฐานข้อมูลที่คุณควบคุมเอง',
        },
        {
          title: 'ข้อมูลของเราอยู่ที่ไหน?',
          description:
            'แล้วแต่คุณตัดสินใจ จะเป็นเซิร์ฟเวอร์ของคุณเอง คลาวด์ในภูมิภาคที่คุณเลือก หรือโครงสร้างพื้นฐานที่เราดูแลให้ก็ได้ ไม่ว่าแบบไหน ฐานข้อมูลก็เป็นของคุณเสมอ',
        },
        {
          title: 'AI จะเข้าไปแตะบัญชีของเราโดยไม่ถามไหม?',
          description:
            'ไม่ AI Agent ทำหน้าที่เหมือนผู้ใช้งานคนหนึ่ง มีสิทธิ์ตามที่คุณกำหนด และทุกการกระทำถูกบันทึกไว้เป็นหลักฐาน สิ่งที่ย้อนกลับไม่ได้จะรอการอนุมัติจากคนเสมอ',
        },
        {
          title: 'เรามี ERP อยู่แล้ว ต้องทิ้งหรือเปล่า?',
          description:
            'คุยกับเราก่อนจะสรุปแบบนั้น ขึ้นอยู่กับระบบเดิมของคุณ เราอาจย้ายระบบ เดินคู่กันไป หรือเริ่มจากความจำและ AI Agent ก่อน โดยที่ข้อมูลเดิมของคุณยังอยู่ที่เดิม',
        },
      ]}
    />

    <!-- Call to action **************** -->
    <CallToAction
      id="talk-to-us"
      title="ติดต่อเรา"
      subtitle="เล่าให้เราฟังว่าบริษัทของคุณเดินอยู่จริง ๆ อย่างไรในวันนี้ แล้วเราจะช่วยวางแผนว่าเราควรเริ่มใช้ความจำและ AI Agent ตรงจุดไหนก่อนจึงจะคุ้มที่สุด"
      callToAction={{
        targetBlank: true,
        text: 'คุยกับเรา',
        href: contactHref,
        icon: 'tabler:mail',
      }}
    />
  </div>
</Layout>

<style>
  /*
    Floworks AI ERP — brand theme, taken from the Floworks logo.
    Scoped to this page only: the site-wide blue/purple tokens are untouched.
      navy   #0B2A4A -> #123A63
      orange #FF7A29 -> #F0580B
      slate  #5A7189
  */
  .floworks-page {
    /* display:contents so the wrapper adds no box and cannot disturb the hero's -105px offset */
    display: contents;

    --aw-color-primary: rgb(255 122 41); /* #FF7A29 — buttons, icons */
    --aw-color-secondary: rgb(11 42 74); /* #0B2A4A — button hover, deep accents */
    --aw-color-accent: rgb(255 122 41); /* #FF7A29 — highlights */
    --aw-color-text-heading: rgb(11 42 74); /* navy headings in light mode */

    /* brand oranges: the deep one is used for text on white (readable), the bright one on navy */
    --fw-orange: rgb(255 122 41); /* #FF7A29 */
    --fw-orange-deep: rgb(240 88 11); /* #F0580B */
  }

  /* Bold text carries the brand orange, site-wide on this page only */
  .floworks-page :global(b),
  .floworks-page :global(strong) {
    color: var(--fw-orange-deep);
  }

  /* On the navy hero the brighter orange reads better */
  .floworks-page > :global(section:first-child) :global(b) {
    color: var(--fw-orange);
  }

  /* Hero: the logo's navy gradient instead of the site's default #0d1b35 */
  .floworks-page > :global(section:first-child) {
    background-color: #0b2a4a;
    background-image: linear-gradient(135deg, #0b2a4a 0%, #123a63 100%);
  }

  /* The hero's particle canvas is hard-coded to a blue palette, which fights the brand.
     Hidden here; the navy gradient carries the hero instead. */
  .floworks-page > :global(section:first-child) :global(#hero-canvas) {
    display: none;
  }

  /* Hero subtitle is text-blue-200 — warm it to match the palette */
  .floworks-page > :global(section:first-child) :global(.text-blue-200) {
    color: rgb(255 224 204);
  }

  /* Hero: ~90% of the default height (684px -> ~616px). The 76px header spacer is untouched. */
  .floworks-page > :global(section:first-child) > :global(div) > :global(div:nth-child(2)) {
    padding-top: 62px;
    padding-bottom: 62px;
  }

  /* Hero title: one size across the whole line. FLOWORKS matches the 'AI ERP' span (text-5xl = 48px),
     instead of the widget's md:text-6xl (60px). */
  .floworks-page > :global(section:first-child) :global(h1) {
    font-size: 3rem;
  }

  /* The Content widget draws its bullets as hard-coded green check circles */
  .floworks-page :global(.bg-green-600) {
    background-color: rgb(255 122 41) !important;
  }

  /* Illustrations in these two sections are shorter than the copy beside them: centre the pair
     vertically instead of leaving all the slack under the image. */
  .floworks-page :global(#a-tuesday) > :global(div) > :global(div) > :global(div),
